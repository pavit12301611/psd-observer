<node>
  <!-- PSD → notch push channel. One method, JSON in, no round-trip:
       kinds: card | status | token | system | dnd | theme -->
  <interface name="io.github.pavit12301611.Notch.Psd">
    <method name="PsdMessage">
      <arg name="json" type="s" direction="in"/>
    </method>
    <method name="PsdOpen">
      <arg name="tab" type="s" direction="in"/>
    </method>
    <method name="PsdState">
      <arg name="state" type="s" direction="out"/>
    </method>
  </interface>
</node>
