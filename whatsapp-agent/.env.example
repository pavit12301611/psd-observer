# ── Copy to .env  (cp .env.example .env)  — .env itself is gitignored ────────
# Fedora quick install: ./scripts/install-fedora.sh (add --service for the
# systemd user service, --ollama for the free local AI). Guide: ../FEDORA.md
# Numbers: country code + number, digits only. A bare 10-digit Indian number
# gets 91 added automatically.

# YOUR personal number — the ONLY number the agent listens to / replies to.
OWNER_NUMBER=919528923866

# The AGENT's own WhatsApp number (second SIM/phone). You link THIS phone as a
# companion device: WhatsApp > Linked devices > Link a device > scan the QR.
AGENT_NUMBER=918859555795

# true = refuse to answer if the linked WhatsApp account is not AGENT_NUMBER.
STRICT_AGENT_NUMBER=false

# Link with an 8-character pairing code instead of scanning a QR (optional).
USE_PAIRING_CODE=false

# If the agent phone unlinks this device (or WhatsApp logs the session out),
# archive the dead login next to auth_info (auth_info_loggedout_<date>/,
# never auto-deleted) and automatically generate a FRESH QR to scan again.
# false = manual recovery instead (./scripts/relink-whatsapp.sh).
AUTO_RELINK=true

# Fedora desktop: open the first linking QR in your image viewer via xdg-open
# (GNOME/KDE). Automatically skipped when headless (systemd service sets false).
OPEN_QR=true

# Display name shown in the agent phone's "Linked devices" list.
DEVICE_NAME=Observer Agent

# ── Phone app + local bridge (no Observer app needed) ─────────────────────────
# 0.0.0.0 = usable from your phone on the same Wi-Fi (PIN/token protected).
# 127.0.0.1 = this PC only. Either way nothing is exposed to the internet
# unless you deliberately open the port (Tailscale/ngrok are better than that).
HOST=0.0.0.0
PORT=8787
# Leave empty: a random token is generated on first run (data/bridge-token.txt)
# and printed in the console. The phone app uses the PIN below to get it.
BRIDGE_TOKEN=
# Opens the phone app (http://PC-IP:8787/). Leave empty to auto-generate a
# 6-digit PIN on first run (data/dashboard-pin.txt, printed at startup).
DASHBOARD_PIN=

# ── Free AI brain (all optional — commands work with none of these) ──────────
# auto = use every configured brain, chosen per task by workload (see below)
# local = only Ollama on this PC · ollama/groq/gemini/openrouter = pin one
# none  = no AI at all (commands + Hinglish intents still work)
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional vision model for describing photos you send, e.g. llava or qwen2.5vl
OLLAMA_VISION_MODEL=
# ── Cloud free tiers (optional — the agent works fully offline without them) ──
# Get keys:
#   Groq        https://console.groq.com/keys    (fast, 1k requests/day)
#   OpenRouter  https://openrouter.ai/keys       (wide model menu, 50/day free)
#   Gemini      https://aistudio.google.com/apikey
# Add one without editing this file:  ./scripts/observer.sh keys groq gsk_...
# Full comparison (limits, models, which one to use): AI-KEYS.md
#
# Groq's free models changed on 16 Aug 2026 — Llama 3.1/3.3 are enterprise-only
# now, so these are the current free IDs:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# qwen/qwen3.8-27b is the only vision model on Groq's free tier.
# Set it empty to disable Groq vision entirely (photos then use local/Gemini).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
# Any :free ID works. Gemma 4 31B = free + vision + tool calls + 262K ctx.
# Alternatives: google/gemma-4-26b-a4b-it:free, openrouter/free (auto-router).
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional separate OpenRouter vision model (blank = main model if it can see)
OPENROUTER_VISION_MODEL=

# ── 100% local models (Hugging Face GGUF via llama.cpp) ─────────────────────
# This is the fully-offline path: no key, no quota, nothing leaves the PC.
# One command sets all of it up:  ./scripts/observer.sh models setup best
# (it downloads the GGUF from Hugging Face, starts llama-server and writes the
#  LOCAL_* values below for you). Everything except the first download works
# offline.
#
# AI_PROVIDER=local means "use only this PC" — no cloud fallback, ever.
# Any OpenAI-compatible server works (llama.cpp / LM Studio / vLLM / koboldcpp).
#
# LOCAL_API_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
#
# Optional extra endpoints: the router then sends tiny jobs to the small model,
# heavy jobs to the big one, and photos to the vision model. Each is a separate
# llama-server on its own port (the setup script does this automatically).
# LOCAL_API_URL_SMALL=http://127.0.0.1:8081/v1
# LOCAL_MODEL_SMALL=unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M
# LOCAL_API_URL_HEAVY=http://127.0.0.1:8082/v1
# LOCAL_MODEL_HEAVY=
# LOCAL_API_URL_VISION=http://127.0.0.1:8083/v1
# LOCAL_MODEL_VISION=ggml-org/gemma-4-12B-it-GGUF:Q4_K_M
# LOCAL_API_KEY=local
#
# Models that fit your machine:  ./scripts/observer.sh models recommend
# Hugging Face download commands: ./scripts/observer.sh models commands best

# ── Workload routing (2.1) ────────────────────────────────────────────────────
# Every message is sized first (tiny / light / standard / heavy), then the
# cheapest model that can actually do that job is used:
#   "hi"                  -> tiny     -> small local model, ~instant
#   "folder saaf karo…"   -> standard -> a capable model (local 14B+ or free 70B)
#   "write a script …"    -> heavy    -> best available, capped by the budget
# /brains in WhatsApp shows the live decision + health.
#
# Optional extra sizes per provider. Leave empty and the main model covers it.
# Small local model for one-liners (fast, light on CPU):
OLLAMA_MODEL_SMALL=
# Bigger local model for heavy work, if you have RAM (e.g. qwen2.5:14b):
OLLAMA_MODEL_HEAVY=
# Groq's small model handles tiny/light cloud work when local is busy:
# (GROQ_MODEL_SMALL is set above, in the Groq block)
# Optional bigger Gemini for heavy work (free tier): gemini-2.5-pro
GEMINI_MODEL_HEAVY=
# local = free/private first · cloud = fastest cloud first · balanced = local for light work
ROUTER_PREFER=local
# A brain that fails is skipped for this long, doubling each time (max below),
# so one dead provider never slows WhatsApp down again.
MODEL_COOLDOWN_MS=120000
MODEL_COOLDOWN_MAX_MS=1800000
# Power budget: max "heavy" (big-model) calls per hour. 0 = unlimited.
MAX_HEAVY_PER_HOUR=12
HEAVY_WINDOW_MS=3600000
# Per-call timeout for an AI brain (ms). Cloud is usually faster than local.
AI_TIMEOUT_MS=60000
# Show "🧠 standard · llama3.2 · 3 steps" under normal AI replies (/agent
# always shows it, so "done" is provable).
SHOW_ROUTING_FOOTER=false

# ── Acting through Observer (screen/camera/MCP tools) ─────────────────────────
# false = agent answers locally; use "/observer <text>" to forward one message.
# true  = every non-command message is first offered to the open Observer tab
#         (needs the patched app + bridge set up, see FREE_WHATSAPP.md).
FORWARD_TO_OBSERVER=false
OBSERVER_WAIT_MS=90000

# ── Power level ───────────────────────────────────────────────────────────────
# safe     = read-only: status, screenshot, OCR, lookups
# standard = apps, files, Wi-Fi, Bluetooth, typing/clicking, downloads, media…
# full     = standard + shutdown/reboot/suspend (default; you asked for it all)
# Destructive actions ALWAYS ask for /yes first, at every level.
ACCESS_LEVEL=full

# Extra folders the file tools may touch, comma separated. Your home folder is
# always allowed. Example: /mnt/data,/media/backup
FILES_EXTRA_ROOTS=

# Seconds a parked destructive action waits for "haan"/"yes".
CONFIRM_TTL_MS=120000

# Free AI tool-calling: plain language → real multi-step PC actions.
AGENT_TOOLS=true
MAX_AGENT_STEPS=6
# How many tool definitions go to the model per request (small models have
# small contexts; 20 keeps the important ones visible).
AGENT_TOOL_LIMIT=20
# Ollama context window (llama3.2 handles 8192 comfortably on 8 GB RAM).
OLLAMA_NUM_CTX=8192

# Automation safety: older builds clicked hard-coded screen positions when OCR
# missed a button. That can hit anything, so it is OFF. Leave it off unless you
# really know your screen layout; /auto reports what it could not find instead.
ALLOW_BLIND_CLICKS=false

# ── "hands": computer use (src/hands.js) ──────────────────────────────────
# The agent looks at a screenshot, does ONE action (click/type/scroll), looks
# again — like a person. Used by /use and by the computer_use tool.
# Hard step budget per task (1-20), overall time budget, and the settle time
# after each action before the next screenshot (550ms = snappy).
HANDS_MAX_STEPS=8
HANDS_MAX_SECONDS=240
HANDS_STEP_DELAY_MS=550
# Screenshots are downscaled to this width + JPEG quality before they leave
# the PC (fewer vision tokens → faster steps).
HANDS_IMAGE_WIDTH=1024
HANDS_JPEG_QUALITY=70
# Vision-first screen control: the model reads the screenshot itself.
# HANDS_USE_OCR=true also sends an OCR word table (more exact for dense text,
# ~1-2s slower per step).
HANDS_USE_OCR=false

# Screenshots are deleted automatically after this many minutes (default 4).
# Set SCREENSHOT_CLEANUP=false to keep every screenshot on disk.
SCREENSHOT_TTL_MINUTES=4
SCREENSHOT_CLEANUP=true
# Max tokens the vision model may write per step (one JSON action needs <100).
HANDS_MAX_TOKENS=512
# Which vision provider /use prefers: auto | gemini | groq | openrouter | local
# auto = Gemini Flash → Groq qwen-vision → OpenRouter → local → Ollama.
SCREEN_PROVIDER=auto
# Screenshots go to the vision model. With no local vision model configured,
# that is a cloud free tier (Gemini/Groq). Set false to keep every screenshot
# on this PC — hands then needs OLLAMA_VISION_MODEL or LOCAL_API_URL_VISION.
ALLOW_CLOUD_SCREEN=true

# Long text typing: characters per ydotool call, and the pause between chunks.
# Bigger chunks = faster; smaller = safer for slow editors/Electron apps.
TYPE_CHUNK_CHARS=180
TYPE_CHUNK_DELAY_MS=60

# Wayland screenshot permission dialog: how long to wait for "Allow" (ms).
# Raise it if you're often away from the PC when asking for a screenshot.
PORTAL_TIMEOUT_MS=60000

# Text OCR for screenshots/photos/documents (offline, free).
# sudo dnf install tesseract tesseract-langpack-hin
OCR_LANGS=eng

# Voice → text (voice notes + live calls). Local whisper first, Groq fallback.
# One command installs local whisper:  bash scripts/observer.sh voice whisper
# (installed to ~/.local/share/observer-voice — auto-detected, nothing to set).
# Manual: WHISPER_BIN=whisper-cli ka path, WHISPER_MODEL=ggml-base.bin ka path.
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_MODEL_GROQ=whisper-large-v3-turbo
# auto = Hinglish detect; or hi, en, …
WHISPER_LANGUAGE=auto

# ── JARVIS voice (3.0) — neural British butler, offline ──────────────────────
# SAB KUCHH EK COMMAND ME:  bash scripts/observer.sh voice setup
#   → Piper neural + en_GB-alan-medium (sabse close free JARVIS) auto-install,
#     ~/.local/share/observer-voice me, bina .env chhede kaam karta hai.
# Engine order: XTTS clone → Piper en_GB → Edge en-GB-Ryan → espeak robot.
# TTS_VOICE=jarvis|jarvis-deep|female|hindi|slow|fast|special (purane preset bhi)
TTS_ENGINE=auto
TTS_VOICE=jarvis
TTS_LANG=auto
# JARVIS ki "digital sheen" + warmth (ffmpeg). Band karna ho to none.
TTS_FX=jarvis
# Awaaz thodi aur gehri? 0.94. Natural rakhna ho to khaali/0.
#JARVIS_PITCH=0.94
# JARVIS tumhe kis naam se bulaye (call + AI persona):
JARVIS_ADDRESS=Sir
JARVIS_PERSONA=true
# Piper manual paths (observer.sh voice setup ke baad zaroorat nahi):
#PIPER_BIN=/home/YOURUSER/.local/share/observer-voice/piper/piper
#PIPER_MODEL=/home/YOURUSER/.local/share/observer-voice/models/en_GB-alan-medium.onnx
PIPER_LENGTH_SCALE=1.05
# True voice CLONE (advanced): apna Coqui XTTS server + reference clip (VOICE.md)
#XTTS_URL=http://127.0.0.1:8020
#XTTS_SPEAKER=jarvis.wav

# ── Voice calls (3.0) ────────────────────────────────────────────────────────
# Phone app ka 📞 Call tab + WhatsApp voice mode (/call on):
VOICE_CALL=true
# Har WhatsApp text jawab ke saath JARVIS voice note bhi (default off;
# WhatsApp pe /call on bolke kabhi bhi chalu/band kar sakte ho):
WHATSAPP_VOICE_REPLIES=false
VOICE_MAX_SPOKEN_CHARS=340
# ── ASLI WhatsApp voice call uthana (experimental) ──
# Official Baileys call utha NAHI sakta; iske liye experimental VoIP engine
# (baileys-caller, WhatsApp Web ka VoIP WASM) doosre linked device pe chalta
# hai. Setup (ek baar):  bash scripts/observer.sh voice call-engine
# phir QR scan:          bash scripts/observer.sh voice link-voip
WA_CALL_ANSWER=false
# Engine ready na ho to incoming owner call par kya karein?
# voice-session = call kaat ke turant JARVIS voice note + voice mode ON
# ignore = kuch mat karo (agent phone bajta rahe) · reject = seedha kaat do
WA_CALL_FALLBACK=voice-session
WA_CALL_UNKNOWN=ignore
WA_CALL_MAX_MINUTES=15
#VOIP_AUTH_DIR=auth_info_voip

# ── Safety ────────────────────────────────────────────────────────────────────
# Arbitrary shell, OFF by default — the one action that can undo anything.
# Turning this on means whoever controls the owner's WhatsApp controls this PC.
# Requires a PIN: /run <PIN> <cmd> (or start a message with the PIN).
ALLOW_SHELL=false
SHELL_PIN=
SHELL_TIMEOUT_MS=20000

# PC control (/pc …) — tier 1 is ALWAYS on: screenshot, volume, brightness,
# media, open app/link, notify, lock, clipboard, find/get files under $HOME.
# Tier 2 = keyboard/mouse input and power (suspend/reboot/shutdown, which also
# ask "/pc confirm" first). On by default now; set false to disable input.
# Tools to install:
#   sudo dnf install grim gnome-screenshot scrot playerctl brightnessctl ydotool xdotool wl-clipboard libnotify tesseract
#   sudo systemctl enable --now ydotool    (Wayland input daemon)
# Element finder: /pc tap Login finds buttons by label via tesseract OCR;
# OLLAMA_VISION_MODEL (e.g. qwen2.5-vl) adds icon-finding as a fallback.
ALLOW_PC_CONTROL=true
# ydotool's daemon socket, if your package puts it somewhere non-standard.
# Default paths checked: /tmp/.ydotool_socket, /run/ydotoold/socket.
# YDOTOOL_SOCKET=
# Optional extra PIN for tier-2 commands, e.g. /pc type 1234 hello (set one!)
CONTROL_PIN=

TIMEZONE=Asia/Kolkata
# Testing only: POST /api/simulate to try commands without a linked phone.
ALLOW_SIMULATE=false

# ── DeepSeek Harness (`@deepseek-ai/dsh`) — Full-Power Agent on Linux ────────
# Runs official DeepSeek Harness alongside Observer on Fedora Linux:
#   • WhatsApp `/dsh <task>` (or `/dsh auto on` for EVERY WhatsApp message!)
#   • Official Web/Desktop UI via `/dsh web` or `bash scripts/observer.sh harness web`
#   • Full native tools (`bash`, `read_file`, `write_file`, `edit_file`, `glob`,
#     `grep`, `subagent`, `skill`, `cron`, `lsp`) + live `mcp-observer` server
#     (WhatsApp send message/file/screenshot + Fedora desktop vision & control).
# Leave DEEPSEEK_API_KEY empty to sign in with your DeepSeek Account inside
# `/dsh web` OR automatically use your configured Groq / OpenRouter / Local GGUF brain!
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# true = launch `dsh web` automatically whenever the WhatsApp agent starts.
DSH_AUTO_START_WEB=false
# true = route ALL plain WhatsApp messages through DeepSeek Harness by default
# (can also toggle anytime from WhatsApp with `/dsh auto on` / `/dsh auto off`).
DSH_AUTO_ROUTE=false
# danger-full-access (default: full Linux shell + files + subagents, zero prompts)
# | workspace-write | read-only
DSH_PERMISSION_MODE=danger-full-access
# Optional explicit model override, e.g. deepseek/deepseek-reasoner,
# deepseek/deepseek-chat, observer-groq/openai/gpt-oss-120b, or blank for auto.
DSH_MODEL=
DSH_WEB_PORT=3080
DSH_REMOTE_PORT=3081
DSH_TRUSTED_HOSTS=

# ── Storage (defaults keep everything inside whatsapp-agent/) ────────────────
# Prefer Fedora/XDG locations? Uncomment (paths may be absolute). If you move
# an existing login, move the whole auth_info folder, then if SELinux denies
# access run:  restorecon -Rv ~/.local/state/observer-whatsapp-agent
#DATA_DIR=/home/YOURUSER/.local/share/observer-whatsapp-agent
#AUTH_DIR=/home/YOURUSER/.local/state/observer-whatsapp-agent/auth_info
