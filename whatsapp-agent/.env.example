# ── Copy to .env  (cp .env.example .env)  — .env itself is gitignored ────────
# Fedora quick install: ./scripts/install-fedora.sh (add --service for the
# systemd user service, --ollama for the free local AI). Guide: ../FEDORA.md
# Numbers: country code + number, digits only. A bare 10-digit Indian number
# gets 91 added automatically.

# YOUR personal number — the ONLY number the agent listens to / replies to.
OWNER_NUMBER=919528923866

# The AGENT's own WhatsApp number (second SIM/phone). You link THIS phone as a
# companion device: WhatsApp > Linked devices > Link a device > scan the QR.
AGENT_NUMBER=918859555795

# true = refuse to answer if the linked WhatsApp account is not AGENT_NUMBER.
STRICT_AGENT_NUMBER=false

# Link with an 8-character pairing code instead of scanning a QR (optional).
USE_PAIRING_CODE=false

# Fedora desktop: open the first linking QR in your image viewer via xdg-open
# (GNOME/KDE). Automatically skipped when headless (systemd service sets false).
OPEN_QR=true

# Display name shown in the agent phone's "Linked devices" list.
DEVICE_NAME=Observer Agent

# ── Local bridge (Observer app <-> agent) ─────────────────────────────────────
# Keep HOST on 127.0.0.1 unless you know you need LAN access.
HOST=127.0.0.1
PORT=8787
# Leave empty: a random token is generated on first run (data/bridge-token.txt)
# and printed in the console. The Observer app sends it to use the bridge.
BRIDGE_TOKEN=

# ── Free AI brain (all optional — commands work with none of these) ──────────
# auto = try Ollama (local, 100% free) -> Groq free -> Gemini free -> OpenRouter free
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional vision model for describing photos you send, e.g. llava or qwen2.5vl
OLLAMA_VISION_MODEL=
# Free-tier keys only if you want a cloud brain (never required):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Acting through Observer (screen/camera/MCP tools) ─────────────────────────
# false = agent answers locally; use "/observer <text>" to forward one message.
# true  = every non-command message is first offered to the open Observer tab
#         (needs the patched app + bridge set up, see FREE_WHATSAPP.md).
FORWARD_TO_OBSERVER=false
OBSERVER_WAIT_MS=90000

# ── Safety ────────────────────────────────────────────────────────────────────
# Arbitrary shell from WhatsApp, OFF by default. Turning this on means whoever
# controls the owner WhatsApp controls this PC. Requires a PIN: /run <PIN> <cmd>
ALLOW_SHELL=false
SHELL_PIN=

# PC control (/pc …) — tier 1 is ALWAYS on: screenshot, volume, brightness,
# media, open app/link, notify, lock, clipboard, find/get files under $HOME.
# Tier 2 = keyboard/mouse input and power (suspend/reboot/shutdown, which also
# ask "/pc confirm" first). Tier 2 needs this switch; tools to install:
#   sudo dnf install grim gnome-screenshot scrot playerctl brightnessctl ydotool xdotool wl-clipboard libnotify tesseract
#   sudo systemctl enable --now ydotool    (Wayland input daemon)
# Element finder: /pc tap Login finds buttons by label via tesseract OCR;
# OLLAMA_VISION_MODEL (e.g. qwen2.5-vl) adds icon-finding as a fallback.
ALLOW_PC_CONTROL=false
# Optional extra PIN for tier-2 commands, e.g. /pc type 1234 hello (set one!)
CONTROL_PIN=

TIMEZONE=Asia/Kolkata
# Testing only: POST /api/simulate to try commands without a linked phone.
ALLOW_SIMULATE=false

# ── Storage (defaults keep everything inside whatsapp-agent/) ────────────────
# Prefer Fedora/XDG locations? Uncomment (paths may be absolute). If you move
# an existing login, move the whole auth_info folder, then if SELinux denies
# access run:  restorecon -Rv ~/.local/state/observer-whatsapp-agent
#DATA_DIR=/home/YOURUSER/.local/share/observer-whatsapp-agent
#AUTH_DIR=/home/YOURUSER/.local/state/observer-whatsapp-agent/auth_info
