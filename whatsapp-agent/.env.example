# ── Copy to .env  (cp .env.example .env)  — .env itself is gitignored ────────
# Fedora quick install: ./scripts/install-fedora.sh (add --service for the
# systemd user service, --ollama for the free local AI). Guide: ../FEDORA.md
# Numbers: country code + number, digits only. A bare 10-digit Indian number
# gets 91 added automatically.

# YOUR personal number — the ONLY number the agent listens to / replies to.
OWNER_NUMBER=919528923866

# The AGENT's own WhatsApp number (second SIM/phone). You link THIS phone as a
# companion device: WhatsApp > Linked devices > Link a device > scan the QR.
AGENT_NUMBER=918859555795

# true = refuse to answer if the linked WhatsApp account is not AGENT_NUMBER.
STRICT_AGENT_NUMBER=false

# Link with an 8-character pairing code instead of scanning a QR (optional).
USE_PAIRING_CODE=false

# If the agent phone unlinks this device (or WhatsApp logs the session out),
# archive the dead login next to auth_info (auth_info_loggedout_<date>/,
# never auto-deleted) and automatically generate a FRESH QR to scan again.
# false = manual recovery instead (./scripts/relink-whatsapp.sh).
AUTO_RELINK=true

# Fedora desktop: open the first linking QR in your image viewer via xdg-open
# (GNOME/KDE). Automatically skipped when headless (systemd service sets false).
OPEN_QR=true

# Display name shown in the agent phone's "Linked devices" list.
DEVICE_NAME=Observer Agent

# ── Phone app + local bridge (no Observer app needed) ─────────────────────────
# 0.0.0.0 = usable from your phone on the same Wi-Fi (PIN/token protected).
# 127.0.0.1 = this PC only. Either way nothing is exposed to the internet
# unless you deliberately open the port (Tailscale/ngrok are better than that).
HOST=0.0.0.0
PORT=8787
# Leave empty: a random token is generated on first run (data/bridge-token.txt)
# and printed in the console. The phone app uses the PIN below to get it.
BRIDGE_TOKEN=
# Opens the phone app (http://PC-IP:8787/). Leave empty to auto-generate a
# 6-digit PIN on first run (data/dashboard-pin.txt, printed at startup).
DASHBOARD_PIN=

# ── Free AI brain (all optional — commands work with none of these) ──────────
# auto = try Ollama (local, 100% free) -> Groq free -> Gemini free -> OpenRouter free
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional vision model for describing photos you send, e.g. llava or qwen2.5vl
OLLAMA_VISION_MODEL=
# Free-tier keys only if you want a cloud brain (never required):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Acting through Observer (screen/camera/MCP tools) ─────────────────────────
# false = agent answers locally; use "/observer <text>" to forward one message.
# true  = every non-command message is first offered to the open Observer tab
#         (needs the patched app + bridge set up, see FREE_WHATSAPP.md).
FORWARD_TO_OBSERVER=false
OBSERVER_WAIT_MS=90000

# ── Power level ───────────────────────────────────────────────────────────────
# safe     = read-only: status, screenshot, OCR, lookups
# standard = apps, files, Wi-Fi, Bluetooth, typing/clicking, downloads, media…
# full     = standard + shutdown/reboot/suspend (default; you asked for it all)
# Destructive actions ALWAYS ask for /yes first, at every level.
ACCESS_LEVEL=full

# Extra folders the file tools may touch, comma separated. Your home folder is
# always allowed. Example: /mnt/data,/media/backup
FILES_EXTRA_ROOTS=

# Seconds a parked destructive action waits for "haan"/"yes".
CONFIRM_TTL_MS=120000

# Free AI tool-calling: plain language → real multi-step PC actions.
AGENT_TOOLS=true
MAX_AGENT_STEPS=6
# How many tool definitions go to the model per request (small models have
# small contexts; 20 keeps the important ones visible).
AGENT_TOOL_LIMIT=20
# Ollama context window (llama3.2 handles 8192 comfortably on 8 GB RAM).
OLLAMA_NUM_CTX=8192

# Text OCR for screenshots/photos/documents (offline, free).
# sudo dnf install tesseract tesseract-langpack-hin
OCR_LANGS=eng

# Voice notes → text. Either set GROQ_API_KEY above (free tier, easiest) or
# point these at a local whisper.cpp build (fully offline):
#   git clone https://github.com/ggerganov/whisper.cpp && make
#   ./models/download-ggml-model.sh base
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_MODEL_GROQ=whisper-large-v3-turbo
# auto = detect; or hi, en, …
WHISPER_LANGUAGE=auto

# ── Safety ────────────────────────────────────────────────────────────────────
# Arbitrary shell, OFF by default — the one action that can undo anything.
# Turning this on means whoever controls the owner's WhatsApp controls this PC.
# Requires a PIN: /run <PIN> <cmd> (or start a message with the PIN).
ALLOW_SHELL=false
SHELL_PIN=
SHELL_TIMEOUT_MS=20000

# PC control (/pc …) — tier 1 is ALWAYS on: screenshot, volume, brightness,
# media, open app/link, notify, lock, clipboard, find/get files under $HOME.
# Tier 2 = keyboard/mouse input and power (suspend/reboot/shutdown, which also
# ask "/pc confirm" first). On by default now; set false to disable input.
# Tools to install:
#   sudo dnf install grim gnome-screenshot scrot playerctl brightnessctl ydotool xdotool wl-clipboard libnotify tesseract
#   sudo systemctl enable --now ydotool    (Wayland input daemon)
# Element finder: /pc tap Login finds buttons by label via tesseract OCR;
# OLLAMA_VISION_MODEL (e.g. qwen2.5-vl) adds icon-finding as a fallback.
ALLOW_PC_CONTROL=true
# Optional extra PIN for tier-2 commands, e.g. /pc type 1234 hello (set one!)
CONTROL_PIN=

TIMEZONE=Asia/Kolkata
# Testing only: POST /api/simulate to try commands without a linked phone.
ALLOW_SIMULATE=false

# ── Storage (defaults keep everything inside whatsapp-agent/) ────────────────
# Prefer Fedora/XDG locations? Uncomment (paths may be absolute). If you move
# an existing login, move the whole auth_info folder, then if SELinux denies
# access run:  restorecon -Rv ~/.local/state/observer-whatsapp-agent
#DATA_DIR=/home/YOURUSER/.local/share/observer-whatsapp-agent
#AUTH_DIR=/home/YOURUSER/.local/state/observer-whatsapp-agent/auth_info
