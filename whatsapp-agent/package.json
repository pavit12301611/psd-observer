{
  "name": "observer-whatsapp-agent",
  "version": "3.13.0",
  "private": true,
  "description": "Owner-controlled WhatsApp agent with trained local routing, safe bounded multitasking, free/local AI and guarded Linux PC tools.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "node --env-file-if-exists=.env src/index.js --dry-run",
    "setup:fedora": "bash scripts/install-fedora.sh",
    "service:install": "bash scripts/install-systemd.sh",
    "service:uninstall": "bash scripts/install-systemd.sh --uninstall",
    "service:status": "systemctl --user status observer-whatsapp-agent",
    "service:logs": "journalctl --user -u observer-whatsapp-agent -f",
    "relink": "bash scripts/relink-whatsapp.sh",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "app": "node --env-file-if-exists=.env src/index.js",
    "models": "bash scripts/local-models.sh",
    "models:list": "bash scripts/local-models.sh list",
    "models:recommend": "bash scripts/local-models.sh recommend",
    "keys": "bash scripts/observer.sh keys",
    "train:wiki": "node scripts/train-wiki.mjs --common",
    "train:neural": "node scripts/train-neural.mjs",
    "train": "node scripts/train-neural.mjs && node scripts/train-wiki.mjs --common",
    "harness": "bash scripts/observer.sh harness",
    "build:bundle": "bash scripts/build-bundle.sh",
    "bench": "node scripts/bench.mjs",
    "test:contracts": "node scripts/test.mjs --contracts",
    "test:coverage": "node scripts/test.mjs --coverage",
    "test:mutation": "node scripts/mutation-check.mjs",
    "audit:report": "node scripts/audit-report.mjs",
    "verify:bundle": "python3 scripts/verify-bundle.py",
    "test:deep": "npm run check && npm run test:coverage && npm run test:mutation && npm run audit:deps && npm run audit:report",
    "audit:deps": "node -e \"require('fs').mkdirSync('.cache/deep-audit',{recursive:true})\" && npm audit --json > .cache/deep-audit/dependency-after.json",
    "app:update": "node scripts/app-update.mjs",
    "app:update:pack": "node scripts/app-update.mjs pack"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bonjour-service": "^1.4.4",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "c8": "^12.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1"
  }
}
