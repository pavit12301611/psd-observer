{
  "name": "observer-whatsapp-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Observer WhatsApp Agent 2.0 - free native WhatsApp + installable phone app with full PC control (Fedora/Linux). No Twilio, no Observer app, no per-message cost.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "node --env-file-if-exists=.env src/index.js --dry-run",
    "setup:fedora": "bash scripts/install-fedora.sh",
    "service:install": "bash scripts/install-systemd.sh",
    "service:uninstall": "bash scripts/install-systemd.sh --uninstall",
    "service:status": "systemctl --user status observer-whatsapp-agent",
    "service:logs": "journalctl --user -u observer-whatsapp-agent -f",
    "relink": "bash scripts/relink-whatsapp.sh",
    "test": "node --test test/agent.test.js test/power.test.js",
    "check": "for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "app": "node --env-file-if-exists=.env src/index.js"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  }
}
